{
  "name": "vani-ai-monorepo",
  "version": "1.0.0",
  "description": "Premium Multilingual Voice-First AI Assistant for Indian Users",
  "main": "api/index.js",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm --prefix backend run vercel-build && npm --prefix frontend run build",
    "vercel-build": "npm --prefix backend run vercel-build && npm --prefix frontend run build",
    "postinstall": "npm --prefix backend run vercel-build",
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "start": "node backend/server.js",
    "test": "npm --prefix backend test && npm --prefix frontend test -- --run",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test -- --run",
    "lint": "npm --prefix frontend run lint"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.8.0",
    "@tiny-fish/sdk": "^0.8.0",
    "axios": "^1.6.8",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "form-data": "^4.0.5",
    "helmet": "^8.2.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.47.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^7.8.0",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "Antigravity",
  "license": "MIT"
}
