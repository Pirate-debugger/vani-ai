# ==============================================================================
# VANI AI BACKEND CONFIGURATION (.env.example)
# ==============================================================================

NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Database Configuration
DATABASE_URL="file:./prisma/dev.db"
DATABASE_PROVIDER=sqlite
# DATABASE_URL="postgresql://vani:password@localhost:5432/vani_ai?schema=public"
# DATABASE_PROVIDER=postgresql

# AI Provider Keys
SARVAM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_DOCUMENT_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
TINYFISH_API_KEY=

# Security & Session Secrets
SESSION_SECRET=super_secret_session_key_change_in_production_min_32_chars
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Client & CORS Origin Settings
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Error Tracking & Observability
SENTRY_DSN=

# Email Delivery
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@vani.ai

# Demo Mode
VANI_DEMO_MODE=false
