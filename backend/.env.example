# ==============================================================================
# VANI AI BACKEND CONFIGURATION (.env)
# NOTE: All variables below are BACKEND-ONLY and MUST NEVER be exposed to Vite/React.
# ==============================================================================

PORT=5000
DATABASE_URL="file:./prisma/dev.db"

# AI Provider Keys
SARVAM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_DOCUMENT_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
TINYFISH_API_KEY=

# Security & Session Secrets
SESSION_SECRET=replace-with-long-random-string-min-32-chars
ENCRYPTION_KEY=your-32-byte-hex-string-for-aes-256-gcm

# Google OAuth Credentials (optional - local authentication works out-of-the-box)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Client & CORS Origin Settings
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGIN=http://localhost:3000,http://localhost:5173
