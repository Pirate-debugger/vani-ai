# ==============================================================================
# VANI AI - MASTER ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Database Configuration
# Local SQLite default:
DATABASE_URL="file:./prisma/dev.db"
DATABASE_PROVIDER=sqlite
# Production PostgreSQL example:
# DATABASE_URL="postgresql://vani:password@localhost:5432/vani_ai?schema=public"
# DATABASE_PROVIDER=postgresql

# AI Provider API Keys
SARVAM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_DOCUMENT_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
TINYFISH_API_KEY=

# Cryptography & Session Storage
# SESSION_SECRET must be at least 32 characters long
SESSION_SECRET=super_secret_session_key_change_in_production_min_32_chars
# ENCRYPTION_KEY must be a 64-character hex string (32 bytes) for AES-256-GCM
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Client & CORS Allowlist
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Error Tracking & Observability (Optional)
SENTRY_DSN=

# Email Delivery (Optional)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@vani.ai

# Demo / Offline Simulation Mode
VANI_DEMO_MODE=false
